{
	"name": "query-keys",
	"version": "0.1.2",
	"private": false,
	"description": "A fully typed, simple utility for your query keys.",
	"keywords": [
		"query-keys",
		"react-query",
		"tanstack-query",
		"typescript",
		"utility"
	],
	"homepage": "https://github.com/symsmith/query-keys",
	"bugs": {
		"url": "https://github.com/symsmith/query-keys/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/symsmith/query-keys.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest",
		"ts": "tsc --noEmit",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint --type-aware --report-unused-disable-directives --deny-warnings",
		"check": "pnpm fmt:check && pnpm lint && pnpm test run && pnpm ts && pnpm build",
		"npm:publish": "pnpm check && npm publish"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.2",
		"oxfmt": "^0.28.0",
		"oxlint": "^1.43.0",
		"oxlint-tsgolint": "^0.11.5",
		"publint": "^0.3.17",
		"tsdown": "^0.18.1",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	}
}
